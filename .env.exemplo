# Copie para .env e preencha. NUNCA commite o .env.

# --- E-mail (IMAP) ---
EMAIL_IMAP_HOST=imap.gmail.com          # Outlook: outlook.office365.com
EMAIL_USER=voce@empresa.com
EMAIL_APP_PASSWORD=xxxx                 # senha de APLICATIVO, não a principal
EMAIL_SPAM_FOLDER=[Gmail]/Spam          # Outlook: Junk

# --- Help desk --
HELPDESK_AGENT_NAME='Seu Nome;Colega 1;Colega 2'   # nomes como no Milldesk, separados por ;
HELPDESK_API_KEY=xxxx
# Fallback: so e usado quando listTicketStatus nao responde. A fila normal NAO
# sai daqui -- ver HELPDESK_STATUS_EXCLUIDOS abaixo.
HELPDESK_STATUS_ABERTOS=''
# REGRA GLOBAL: "chamado em aberto" = TODOS os status da API menos estes.
# Comparacao exata, sem acento e sem caixa: 'Fechado' nao casa com 'Fechados'.
# Nome que nao existir na API vira aviso em helpdesk.json -> aviso_status.
# Na instalacao atual existem 17 status e so 'Fechado' encerra o chamado.
HELPDESK_STATUS_EXCLUIDOS='Fechado'
# Status que contam como trabalho ativo no card de cada dev (somados e exibidos
# juntos). Comparacao EXATA, nao por trecho.
HELPDESK_STATUS_TRABALHO='Com o Desenvolvedor;Em atendimento'
HELPDESK_SOLICITANTE_ATENDIMENTO=
# Segundo modo de registrar atendimento diario: o servico novo marca o chamado
# com esta tag no TITULO, e nele quem atendeu esta no CAMPO do chamado (agent),
# nao na descricao. Os dois modos somam no mesmo por_tecnico.
# Vazio desliga o modo e a saida volta a ser a de antes.
HELPDESK_TAG_ATENDIMENTO='AtendimentoDiario'
HELPDESK_TAG_CAMPOS='ticket'            # onde procurar a tag (separados por ",")
# O campo do chamado e a descricao escrevem a MESMA pessoa de formas diferentes
# ('Fabio' com acento x sem, 'Guilherme P.' x 'Guilherme', 'Luiz' x 'Luiz
# Araujo'). Sem este mapa a soma empilha a pessoa em duas linhas do painel.
# Formato 'Rotulo=apelido1,apelido2'. A comparacao e EXATA (sem acento e sem
# caixa), NAO por trecho: existem 'Guilherme P.' e 'Guilherme Anderson dos
# Santos' e sao pessoas diferentes -- um trecho 'guilherme' fundiria as duas.
# Use do lado esquerdo o rotulo que a DESCRICAO ja produz (para o dado atual nao
# mudar) e do lado direito o nome EXATO do campo do chamado.
# Nome nao reconhecido vira linha propria e aparece em por_modo.tag.nomes_sem_mapa.
HELPDESK_TECNICOS_CANONICOS='Fabio=fabio;Roberto=roberto;Guilherme=guilherme p.;Luiz Araujo=luiz,luiz araujo'

# Desenvolvedores, como aparecem no Milldesk, separados por ";".
# Vazio = o bloco de desenvolvimento sai vazio e o dashboard avisa.
# Rode `python coletores/check_helpdesk.py --listar-categorias` para ver os nomes reais.
HELPDESK_DEV_NAMES='Dev 1;Dev 2;Dev 3'
# Equipes dentro do desenvolvimento, mesmo formato do mapa de sistemas.
# Ex.: 'Website=Fulano,Beltrano'. Quem nao casar cai em HELPDESK_DEV_EQUIPE_PADRAO.
HELPDESK_DEV_EQUIPES=''
HELPDESK_DEV_EQUIPE_PADRAO='Sistemas'
# Quais sistemas ganham LISTA de chamados no JSON (a contagem e sempre de todos).
# Guardar os 314 chamados de todos os sistemas levava o helpdesk.json a 389 KB,
# e cada um dos 3 briefings diarios le esse arquivo inteiro. Com a amostra: 63 KB.
HELPDESK_TICKETS_SISTEMAS='Site;Siscam 9'
HELPDESK_TICKETS_LIMITE=25              # teto de cada lista; os mais urgentes primeiro
# Status que significam "esta com o desenvolvimento" (funil de dev)
# ATENCAO: existem DOIS status quase iguais nesta instalacao --
# 'Com o Desenvolvedor' (170) e 'Com o Desenvolvimento' (77). Os dois contam.
# 'Pendente' (26) entra: significa aguardando o desenvolvimento, nao o cliente.
# 'Aprovacao Interna' (1) fica fora. Total: 279 de 314 chamados (89%).
HELPDESK_STATUS_DEV='Com o Desenvolvedor;Com o Desenvolvimento;Aguardando Testes;Pendente'
# Mapa sistema -> trechos procurados na categoria do chamado (sem acento, sem caixa).
# Formato: 'Rotulo=trecho1,trecho2;Outro=trecho3'. A ordem importa: o primeiro que casa vence.
# O que nao casar com nenhuma regra cai em "Outros".
# Mapa conferido contra a fila real: classifica 314 de 314, nada sobra em 'Outros'.
HELPDESK_SISTEMAS='Siscam 9=siscam 9,siscam9,siscam web,siscam-web;Siscam 8=siscam 8,siscam8;Site=site;Cartórios=cartorio;Painel de Votação=painel de votacao;APP Mobile=app mobile,aplicativo mobile;Legislação Digital=legisla;Gabinete=gabinete,recepcao;Infraestrutura=servidor de e-mail,servidor de email'

# --- Sistema de licenças (interno) ---
LICENCAS_BASE_URL=
LICENCAS_USUARIO='seu.usuario'
LICENCAS_SENHA='sua-senha'
LICENCAS_PAGINA=/
LICENCAS_IGNORAR='homologação;homologacao;teste;backup'

# --- Dashboard (gerar_dashboard.py) ---
DASHBOARD_MOSTRAR_RANKING=true          # false = sem nomes de tecnicos no HTML
DASHBOARD_DIAS_GRAFICO=30               # dias do historico nos graficos
# Sistemas com card proprio nos Destaques (rotulos de HELPDESK_SISTEMAS, separados por ";")
DASHBOARD_SISTEMAS_DESTAQUE='Siscam 9;Siscam 8;Site'
# Sistemas com tabela de chamados no Briefing (o Siscam 8 fica de fora de proposito)
DASHBOARD_SISTEMAS_BRIEFING='Site;Siscam 9'

# Observacao: a pagina do financeiro (dashboard_financeiro.html) NUNCA mostra nome
# de tecnico, independente de DASHBOARD_MOSTRAR_RANKING. Isso e imposto no codigo.
